---
import Default from '@astrojs/starlight/components/ContentPage.astro';
import RelatedArticles from '../RelatedArticles.astro';
const { entry } = Astro.props;
const isBlog = entry?.data?.isBlog;
const related = isBlog && entry.data.related?.length > 0 ? entry.data.related : null;
---

<Default {...Astro.props} />
{related && (
  <RelatedArticles related={related} />
)}